{
  "$meta": {
    "product": "Loc.ai Link",
    "description": "Design tokens for the Loc.ai Link macOS desktop app (menu-bar app + first-run Setup Assistant). Values extracted verbatim from the approved HTML prototype. Two families are documented: (1) BRAND/APP tokens — the Loc.ai design system, used in the Setup Assistant and the Locai Link menu; (2) MACOS-SYSTEM tokens — the stock macOS Installer chrome. The system chrome should be produced by the OS / a real .pkg, NOT hand-built; its values are listed only so a faithful mock can be rendered if needed.",
    "baseRemPx": 16,
    "units": "All sizes are CSS px unless noted. rem assumes a 16px root."
  },

  "color": {
    "brand": {
      "ink":            { "value": "#0A0A0A", "use": "Primary text, dark surfaces (Setup rail, app icon)" },
      "paper":          { "value": "#FFFFFF", "use": "Default surface / card background" },
      "signal-green":   { "value": "#00D26A", "use": "Live / active state, status dots, progress fills, success" },
      "green-deep":     { "value": "#00B85A", "use": "AA-legible green text, primary green button fill, accents" },
      "green-pressed":  { "value": "#00A852", "use": "Border on the primary green button" },
      "error":          { "value": "#E84D3D", "use": "Port conflict / destructive / error" },
      "warning":        { "value": "#E8B23D", "use": "‘Configuring’ status dot" },
      "warning-text":   { "value": "#C98A1E", "use": "Inline warning copy (e.g. ‘No downloaded models yet’)" }
    },

    "text": {
      "strong":     { "value": "#0A0A0A", "use": "Headlines, key values (brand surfaces)" },
      "default":    { "value": "#1A1A1A", "use": "Body headings on light (installer)" },
      "secondary":  { "value": "#46443F", "use": "Body copy, secondary labels" },
      "muted":      { "value": "#8A877F", "use": "Tertiary labels (Node, Base URL keys)" },
      "faint":      { "value": "#A6A39C", "use": "Meta lines, placeholder-level text" },
      "disabled":   { "value": "#B5B2AB", "use": "Disabled button text, counters" },
      "on-dark":    { "value": "#FFFFFF", "use": "Text on ink surfaces" },
      "on-dark-70": { "value": "rgba(255,255,255,0.78)", "use": "Completed step labels on rail" },
      "on-dark-45": { "value": "rgba(255,255,255,0.45)", "use": "Pending step labels / eyebrow on rail" }
    },

    "surface": {
      "base":         { "value": "#FFFFFF" },
      "cream":        { "value": "#FAF9F6", "use": "Inset cards on light (org card, finish card)" },
      "cream-alt":    { "value": "#FBFAF7", "use": "Setup footer bar" },
      "hover":        { "value": "#F5F4F1", "use": "List-row hover (neutral)" },
      "tint-green":   { "value": "#F2FBF6", "use": "Green-tinted hover / Autoselect chip bg / models-row hover" },
      "tint-green-2": { "value": "#F6FCF9", "use": "Downloaded model card bg" },
      "tint-green-3": { "value": "#EAF9F1", "use": "‘Recommended’ pill bg" },
      "dark-rail":    { "value": "#0A0A0A", "use": "Setup Assistant left rail" }
    },

    "border": {
      "hairline":      { "value": "#ECEAE4", "use": "Dividers, card hairlines (primary)" },
      "default":       { "value": "#E7E5E4", "use": "Menu / popover border, disabled button" },
      "strong":        { "value": "#DCD9D2", "use": "Inputs at rest" },
      "input":         { "value": "#D9D6CF", "use": "Secondary button / download button border" },
      "checkbox-off":  { "value": "#C9C6BE", "use": "Unchecked serve checkbox border" },
      "green-tint":    { "value": "#BFE9CF", "use": "Serving port input border / Autoselect chip border" },
      "green-tint-2":  { "value": "#CFEBD9", "use": "Downloaded model card border" }
    },

    "status": {
      "live":         { "value": "#00D26A", "use": "Serving / online dot (animated pulse)" },
      "online-deep":  { "value": "#00B85A", "use": "Menu-bar status dot + ‘ONLINE’ label" },
      "configuring":  { "value": "#E8B23D", "use": "Setup rail status dot while configuring" },
      "conflict":     { "value": "#E84D3D", "use": "Duplicate-port highlight" }
    },

    "macos-system": {
      "$note": "Stock macOS Installer.app chrome. Prefer native rendering; do not hand-build for production.",
      "window-bg":        "#ECECEC",
      "titlebar-top":     "#F6F6F6",
      "titlebar-bottom":  "#E5E5E5",
      "titlebar-border":  "#C9C9C9",
      "sidebar-bg":       "#DCDCDC",
      "sidebar-border":   "#C4C4C4",
      "footer-bg":        "#F7F7F7",
      "footer-border":    "#E2E2E2",
      "field-bg":         "#FAFAFA",
      "field-border":     "#DADADA",
      "traffic-red":      "#FF5F57",
      "traffic-amber":    "#FEBC2E",
      "traffic-green":    "#28C840",
      "traffic-inactive": "#DDDDDD",
      "accent-blue":         "#2A7DE1",
      "accent-blue-hover":   "#4D97F0",
      "accent-blue-border":  "#1E6FD0",
      "accent-blue-disabled":"#9FC2EC",
      "success-green":    "#34C759",
      "title-text":       "#3A3A3A",
      "body-text":        "#3A3A3A",
      "label-text":       "#6B6B6B"
    },

    "desktop": {
      "wallpaper-base": "#F2EFE9",
      "wallpaper-radial": ["#FCFBF8", "#F5F3EE", "#EBE8E1"],
      "menubar-bg": "rgba(247,246,241,0.72)",
      "menubar-border": "rgba(10,10,10,0.07)",
      "menubar-text": "rgba(10,10,10,0.82)",
      "dock-bg": "rgba(255,255,255,0.34)",
      "dock-border": "rgba(255,255,255,0.55)"
    }
  },

  "typography": {
    "family": {
      "display": "'Inter Tight', sans-serif",
      "body":    "'Inter', sans-serif",
      "mono":    "'JetBrains Mono', monospace",
      "system":  "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "letterSpacing": {
      "display-tight": "-0.03em",
      "display-tighter": "-0.04em",
      "nav": "-0.005em",
      "mono-100": "0.10em",
      "mono-120": "0.12em",
      "mono-140": "0.14em",
      "mono-160": "0.16em",
      "mono-180": "0.18em",
      "mono-220": "0.22em"
    },
    "lineHeight": { "tight": 1.0, "snug": 1.45, "normal": 1.5, "relaxed": 1.55, "loose": 1.6 },
    "scale": {
      "mono-2xs":  { "px": 8.5,  "rem": "0.531rem", "use": "Column captions, ‘Recommended’ pill" },
      "mono-xs":   { "px": 9,    "rem": "0.563rem", "use": "Section eyebrows in flyout / rail eyebrow" },
      "mono-sm":   { "px": 9.5,  "rem": "0.594rem", "use": "Status labels (ONLINE), step numbers" },
      "mono-md":   { "px": 10,   "rem": "0.625rem", "use": "Eyebrows, meta keys, counters" },
      "body-2xs":  { "px": 11,   "rem": "0.688rem", "use": "Port values, small meta" },
      "body-xs":   { "px": 11.5, "rem": "0.719rem", "use": "Permission description" },
      "body-sm":   { "px": 12,   "rem": "0.750rem", "use": "Secondary labels, license body" },
      "body-md":   { "px": 12.5, "rem": "0.781rem", "use": "List item titles, menu items" },
      "body":      { "px": 13,   "rem": "0.813rem", "use": "Default body copy, nav labels" },
      "body-lg":   { "px": 13.5, "rem": "0.844rem", "use": "Model names, inputs" },
      "ui-lg":     { "px": 14,   "rem": "0.875rem", "use": "Menu header ‘Link’" },
      "title-sm":  { "px": 17,   "rem": "1.063rem", "use": "Installer step titles" },
      "title-md":  { "px": 18,   "rem": "1.125rem", "use": "Installer success / Setup rail ‘Link’" },
      "title-lg":  { "px": 19,   "rem": "1.188rem", "use": "Installer welcome heading" },
      "display-sm":{ "px": 23,   "rem": "1.438rem", "use": "Setup step headlines" },
      "display-md":{ "px": 24,   "rem": "1.500rem", "use": "Setup ‘Sign in to Locai’" }
    }
  },

  "spacing": {
    "$note": "Observed padding/margin/gap values. Roughly a 1px-granular system; the recurring rhythm is 6/8/10/12/14/18/22/26/30.",
    "0_5": 2, "1": 3, "1_5": 4, "2": 5, "2_5": 6, "3": 7, "3_5": 8, "4": 9,
    "5": 10, "5_5": 11, "6": 12, "6_5": 13, "7": 14, "8": 16, "9": 18, "9_5": 19,
    "10": 20, "11": 22, "13": 26, "15": 30, "17": 34
  },

  "radius": {
    "xs": 4, "checkbox": 5, "sm": 6, "control": 7, "md": 8, "input": 9,
    "window-installer": 10, "sheet": 11, "card": 12, "window-setup": 13,
    "dock": 22, "pill": 999, "app-icon": "25% of icon size"
  },

  "shadow": {
    "popover":         "0 18px 52px rgba(20,18,14,0.26)",
    "popover-flyout":  "0 18px 52px rgba(20,18,14,0.28)",
    "window-installer":"0 30px 76px rgba(20,18,14,0.32), 0 3px 12px rgba(20,18,14,0.14)",
    "window-setup":    "0 36px 88px rgba(20,18,14,0.34), 0 4px 14px rgba(20,18,14,0.12)",
    "sheet":           "0 20px 50px rgba(0,0,0,0.32)",
    "dock":            "0 12px 34px rgba(20,18,14,0.20), inset 0 1px 0 rgba(255,255,255,0.5)",
    "dock-icon":       "0 2px 5px rgba(0,0,0,0.18)",
    "button-sm":       "0 1px 2px rgba(0,0,0,0.10)",
    "button-xs":       "0 1px 2px rgba(0,0,0,0.08)",
    "toggle-knob":     "0 1px 2px rgba(0,0,0,0.25)",
    "success-halo-green": "0 0 0 7px rgba(0,210,106,0.12)",
    "success-halo-blue":  "0 0 0 7px rgba(52,199,89,0.13)",
    "menubar-dot-glow":   "0 0 5px rgba(0,210,106,0.75)"
  },

  "zIndex": {
    "stage": 30,
    "sheet-overlay": 55,
    "sheet": 56,
    "menu-flyout": 70,
    "dock": 80,
    "menubar": 90
  },

  "motion": {
    "easing-standard": "ease",
    "easing-out": "ease-out",
    "step-fade": { "property": "opacity", "duration": "300ms", "easing": "ease", "note": "Content fades to 0, swaps after a 130ms JS delay, fades back to 1. Net feel ≈ 130ms out + 300ms in." },
    "hover-bg": "120ms",
    "progress-fill": "160-180ms ease",
    "toggle": "150ms",
    "press-scale": "transform: scale(0.93-0.98) on :active",
    "pulse": { "name": "locaiPulse", "keyframes": "0%,100% opacity 1; 50% opacity .4", "duration": "2s", "iteration": "infinite", "use": "Live/serving status dots" },
    "spin": { "name": "locaiSpin", "keyframes": "to { transform: rotate(360deg) }", "duration": "0.7s", "easing": "linear", "use": "Installer progress spinner" }
  }
}
