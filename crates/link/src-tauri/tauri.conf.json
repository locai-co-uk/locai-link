{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locai Link",
  "version": "0.1.0",
  "identifier": "uk.co.locai.link.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Locai Link Preferences",
        "width": 600,
        "height": 700,
        "minWidth": 528,
        "minHeight": 616,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false,
        "titleBarStyle": "Visible"
      },
      {
        "label": "setup",
        "url": "setup.html",
        "title": "Locai Link Setup",
        "width": 900,
        "height": 720,
        "resizable": false,
        "center": true,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:20505 https://control.locai.co.uk https://api.locai.co.uk; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
