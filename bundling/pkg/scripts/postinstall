#!/bin/bash
# SPDX-FileCopyrightText: 2026 Loc.ai Ltd.
# SPDX-License-Identifier: BUSL-1.1
#
# Runs after the .pkg payload has been copied to /Library/Locai.
#
# Payload provides:
#     /Library/Locai/locai-link            (the launcher binary)
#     /Library/Locai/boot.json             (production channel config)
#     /Library/Locai/Setup Assistant.app   (the Tauri first-run app)
#
# This script:
#     1. Ensures the launcher is executable and owned correctly.
#     2. Symlinks /usr/local/bin/locai to the launcher so users can
#        invoke "locai …" from a terminal without a PATH edit.
#     3. Launches Setup Assistant.app so the user picks up in the
#        wizard the moment Installer.app's conclusion pane appears.
#
# We deliberately do NOT register the runtime or menu-bar LaunchAgents
# here — the user's "Run at login" choice is captured by Setup Assistant
# on its Permissions step, so LaunchAgent registration happens on
# Finish rather than at .pkg install time.
#
# pkgbuild passes these positional args:
#     $1 — the .pkg's own path (unused)
#     $2 — the target-location inside the payload (unused)
#     $3 — the target volume ("/" on a normal install)
#     $4 — install location root ("/" for volume-only installs)
set -euo pipefail

INSTALL_ROOT="/Library/Locai"
LAUNCHER="${INSTALL_ROOT}/locai-link"
CLI_SYMLINK="/usr/local/bin/locai"
SETUP_ASSISTANT="${INSTALL_ROOT}/Setup Assistant.app"
SETUP_ASSISTANT_IN_APPLICATIONS="/Applications/Locai Setup Assistant.app"
COMPANION_APP="${INSTALL_ROOT}/Locai Link.app"
COMPANION_SYMLINK="/Applications/Locai Link.app"
UNINSTALLER="${INSTALL_ROOT}/uninstall.sh"

log() {
    echo "[postinstall] $*"
}

# --- 1. Executable + ownership ---------------------------------------
if [[ ! -f "$LAUNCHER" ]]; then
    log "ERROR: launcher not found at $LAUNCHER"
    exit 1
fi
chmod 755 "$LAUNCHER"
# Root-owned: the launcher itself never needs write access. Only the
# launcher binary is locked down; the rest of INSTALL_ROOT stays
# writeable so the OTA updater (running as the user via the
# LaunchAgent) can drop new versions under versions/, flip the
# `current` pointer, and manage its own state.
chown root:wheel "$LAUNCHER"
# Give the invoking user ownership of the install root itself + the
# subtrees the runtime + OTA touch. The console user is resolved
# below; use $SUDO_USER when available (pkg installs run as root via
# sudo), otherwise fall back to the console user we detect for the
# Setup Assistant handoff.
INSTALL_USER="${SUDO_USER:-$(stat -f "%Su" /dev/console 2>/dev/null || echo "root")}"
# LaunchAgents write to $INSTALL_ROOT/logs/*.log — create it here so the
# first launchctl kickstart doesn't fail on a fresh install.
for d in versions state logs; do
    mkdir -p "$INSTALL_ROOT/$d"
done
if [[ "$INSTALL_USER" != "root" ]]; then
    chown "$INSTALL_USER:staff" "$INSTALL_ROOT"
    for d in versions state logs; do
        chown -R "$INSTALL_USER:staff" "$INSTALL_ROOT/$d"
    done
fi
log "launcher installed at $LAUNCHER (writeable state → $INSTALL_USER)"

# --- 2. /usr/local/bin/locai symlink ---------------------------------
# /usr/local/bin exists on macOS 14+ but isn't guaranteed writable in
# every environment. mkdir -p is safe; ln -sf overwrites an existing
# symlink (e.g. from a previous install) without complaint.
mkdir -p "$(dirname "$CLI_SYMLINK")"
ln -sf "$LAUNCHER" "$CLI_SYMLINK"
log "CLI symlink: $CLI_SYMLINK -> $LAUNCHER"

# --- 3. Uninstaller script -------------------------------------------
# uninstall.sh is shipped in the payload but permissions on files
# copied by pkgbuild aren't guaranteed to be executable. Force 755 so
# both the tray menu ("Uninstall Locai Link…" via osascript) and
# `sudo /Library/Locai/uninstall.sh` from Terminal can invoke it.
if [[ -f "$UNINSTALLER" ]]; then
    chmod 755 "$UNINSTALLER"
    chown root:wheel "$UNINSTALLER"
    log "uninstaller ready at $UNINSTALLER"
else
    log "WARN: uninstaller not found at $UNINSTALLER"
fi

# --- 4. /Applications/Locai Link.app ---------------------------------
# The companion menubar app is the user-facing entry point ("open
# Locai Link" in Applications / Spotlight / Launchpad). We used to
# symlink from /Applications back into /Library/Locai; macOS's Launch
# Services doesn't index symlinked .apps into Applications the same
# way it does real bundles, so Spotlight can't find the app and the
# Finder Applications sidebar view misses it.
#
# `ditto` is the macOS-native copy for .apps — preserves the code
# signature, resource forks, and extended attributes that a plain
# `cp -R` may drop. First remove any stale copy/symlink so a repeat
# install lands cleanly.
# lsregister lives outside PATH; used to force LaunchServices to pick up the
# freshly-copied .app (Launchpad + `open -a` + Spotlight-via-LS all read this).
# mdimport alone updates the Spotlight metadata store but not the LS database.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# The console user (person driving Installer.app). Resolved before
# registration: the LS database is per-user, and this script runs as
# root — registering as root doesn't reliably surface the app for the
# logged-in user (app intermittently missing from search otherwise).
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")

# Register an .app with Launch Services + Spotlight, as the console
# user when there is one (headless installs fall back to root).
register_app() {
    local app="$1"
    # Best-effort: registration failure must NOT abort the install (the bundle
    # is already in /Applications and macOS indexes it on the next rescan), but
    # log the real outcome rather than a blanket "ran".
    if [[ -x "$LSREGISTER" ]]; then
        local ok=1
        # Per-user LS DB → prefer the console user, fall back to
        # root. -trusted isn't accepted on every macOS release, so try it then
        # plain before giving up.
        if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
            sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R -trusted "$app" 2>/dev/null \
                || sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R "$app" 2>/dev/null \
                || "$LSREGISTER" -f -R "$app" 2>/dev/null || ok=0
        else
            "$LSREGISTER" -f -R -trusted "$app" 2>/dev/null \
                || "$LSREGISTER" -f -R "$app" 2>/dev/null || ok=0
        fi
        if [[ "$ok" -eq 1 ]]; then
            log "lsregister registered $app (user: ${CONSOLE_USER:-root})"
        else
            log "WARN: lsregister failed for $app — Spotlight may lag until the next rescan"
        fi
    fi
    if command -v mdimport >/dev/null 2>&1; then
        if mdimport "$app" 2>/dev/null; then
            log "mdimport ran on $app"
        else
            log "WARN: mdimport failed for $app"
        fi
    fi
}

if [[ -d "$COMPANION_APP" ]]; then
    rm -rf "$COMPANION_SYMLINK"
    ditto "$COMPANION_APP" "$COMPANION_SYMLINK"
    log "companion copied: $COMPANION_APP -> $COMPANION_SYMLINK"
    register_app "$COMPANION_SYMLINK"
else
    log "companion app not found at $COMPANION_APP — skipping /Applications copy"
fi

# --- 4b. /Applications/Locai Setup Assistant.app ---------------------
# The SA is also copied into /Applications so it's discoverable via
# Spotlight / Launchpad / the Applications sidebar. Users who quit the
# auto-launched SA before completing setup would otherwise have no way
# to reopen it (the /Library/Locai copy isn't indexed by Launch
# Services).
if [[ -d "$SETUP_ASSISTANT" ]]; then
    rm -rf "$SETUP_ASSISTANT_IN_APPLICATIONS"
    ditto "$SETUP_ASSISTANT" "$SETUP_ASSISTANT_IN_APPLICATIONS"
    log "setup assistant copied: $SETUP_ASSISTANT -> $SETUP_ASSISTANT_IN_APPLICATIONS"
    register_app "$SETUP_ASSISTANT_IN_APPLICATIONS"
else
    log "setup assistant not found at $SETUP_ASSISTANT — skipping /Applications copy"
fi

# --- 5. Launch Setup Assistant ---------------------------------------
# The postinstall runs as root; the Setup Assistant must run as the
# actual user for LaunchAgent registration and Keychain access to work
# correctly. CONSOLE_USER was resolved above; hand off with "sudo -u".
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
    # No graphical console user (headless install, remote deployment,
    # or the user is running via Terminal as root). Skip the launch —
    # the user can open Setup Assistant.app manually from Applications.
    log "no console user detected; skipping Setup Assistant auto-launch"
    exit 0
fi

# Prefer the /Applications copy so LaunchServices registers the .app
# by its indexed bundle identity; fall back to the /Library/Locai copy
# if the copy step above failed.
SA_TO_LAUNCH=""
if [[ -d "$SETUP_ASSISTANT_IN_APPLICATIONS" ]]; then
    SA_TO_LAUNCH="$SETUP_ASSISTANT_IN_APPLICATIONS"
elif [[ -d "$SETUP_ASSISTANT" ]]; then
    SA_TO_LAUNCH="$SETUP_ASSISTANT"
fi
if [[ -n "$SA_TO_LAUNCH" ]]; then
    # `open` returns immediately once the .app is dispatched to
    # launchd; the postinstall doesn't hold the Installer.app UI thread.
    sudo -u "$CONSOLE_USER" open -a "$SA_TO_LAUNCH" || {
        log "WARN: failed to launch $SA_TO_LAUNCH; user must launch it manually"
    }
    log "Setup Assistant handed off to $CONSOLE_USER (from $SA_TO_LAUNCH)"
else
    log "Setup Assistant.app not found; user must launch it manually"
fi

exit 0
