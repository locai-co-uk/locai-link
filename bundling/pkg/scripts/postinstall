#!/bin/bash
# SPDX-FileCopyrightText: 2026 Loc.ai Ltd.
# SPDX-License-Identifier: BUSL-1.1
#
# Runs after the .pkg payload has been copied to /Library/Locai.
#
# Payload provides:
#     /Library/Locai/boot.json             (production channel config)
#     /Library/Locai/Locai Link.app        (the app: supervisor + tray + first-run setup)
#
# The single `locai-link` binary lives inside the .app
# (Contents/MacOS/locai-link) — there is no separate launcher.
#
# This script:
#     1. Ensures the .app is present and the state tree is user-owned.
#     2. Symlinks /usr/local/bin/locai to the .app binary so users can
#        invoke "locai …" from a terminal without a PATH edit.
#     3. Removes any legacy Setup Assistant.app (pre-merge installs shipped a
#        separate onboarding app; onboarding is now a window of the main app).
#     4. Launches Locai Link.app; on first run (no registered device) it opens
#        the setup window so the user picks up in the wizard the moment
#        Installer.app's conclusion pane appears.
#
# We deliberately do NOT register the runtime or LaunchAgents here — the
# "Run at login" choice is captured in the setup wizard's Permissions step, so
# registration happens on Finish, not at .pkg install time.
#
# pkgbuild passes these positional args:
#     $1 — the .pkg's own path (unused)
#     $2 — the target-location inside the payload (unused)
#     $3 — the target volume ("/" on a normal install)
#     $4 — install location root ("/" for volume-only installs)
set -euo pipefail

INSTALL_ROOT="/Library/Locai"
CLI_SYMLINK="/usr/local/bin/locai"
COMPANION_APP="${INSTALL_ROOT}/Locai Link.app"
COMPANION_SYMLINK="/Applications/Locai Link.app"
# The merged binary (supervisor + tray) lives inside the .app.
MERGED_BIN="${COMPANION_APP}/Contents/MacOS/locai-link"
UNINSTALLER="${INSTALL_ROOT}/uninstall.sh"
# Legacy onboarding app from pre-merge installs — removed on upgrade.
LEGACY_SA="${INSTALL_ROOT}/Setup Assistant.app"
LEGACY_SA_IN_APPLICATIONS="/Applications/Locai Setup Assistant.app"

log() {
    echo "[postinstall] $*"
}

# --- 1. App present + ownership --------------------------------------
if [[ ! -d "$COMPANION_APP" ]]; then
    log "ERROR: app not found at $COMPANION_APP"
    exit 1
fi
# The .app binary keeps the perms + signature from the build; nothing to
# chmod here. The whole .app is chowned to the user in section 4 so the OTA
# (running as the user via the LaunchAgent) can swap it.
#
# Give the invoking user ownership of the install root + the subtrees the
# runtime + OTA touch. Prefer $SUDO_USER (pkg installs run as root via sudo),
# else fall back to the console user.
INSTALL_USER="${SUDO_USER:-$(stat -f "%Su" /dev/console 2>/dev/null || echo "root")}"
# LaunchAgents write to $INSTALL_ROOT/logs/*.log — create it here so the
# first launchctl kickstart doesn't fail on a fresh install.
for d in versions state logs; do
    mkdir -p "$INSTALL_ROOT/$d"
done
if [[ "$INSTALL_USER" != "root" ]]; then
    chown "$INSTALL_USER:staff" "$INSTALL_ROOT"
    for d in versions state logs; do
        chown -R "$INSTALL_USER:staff" "$INSTALL_ROOT/$d"
    done
fi
log "app installed at $COMPANION_APP (writeable state → $INSTALL_USER)"

# --- 2. /usr/local/bin/locai symlink ---------------------------------
# Points at the .app binary so `locai …` works from a terminal without a PATH
# edit. /usr/local/bin isn't guaranteed writable everywhere. mkdir -p is safe;
# ln -sf overwrites an existing symlink from a previous install.
mkdir -p "$(dirname "$CLI_SYMLINK")"
ln -sf "$MERGED_BIN" "$CLI_SYMLINK"
log "CLI symlink: $CLI_SYMLINK -> $MERGED_BIN"

# --- 3. Uninstaller script -------------------------------------------
# pkgbuild doesn't guarantee copied files are executable. Force 755 so both
# the tray menu (osascript) and `sudo /Library/Locai/uninstall.sh` can run it.
if [[ -f "$UNINSTALLER" ]]; then
    chmod 755 "$UNINSTALLER"
    chown root:wheel "$UNINSTALLER"
    log "uninstaller ready at $UNINSTALLER"
else
    log "WARN: uninstaller not found at $UNINSTALLER"
fi

# --- 4. /Applications/Locai Link.app ---------------------------------
# The companion menubar app is the user-facing entry point. We copy (not
# symlink) it: Launch Services doesn't index symlinked .apps like real
# bundles, so Spotlight / the Finder Applications view would miss it.
#
# `ditto` preserves the code signature, resource forks, and xattrs a plain
# `cp -R` may drop. Remove any stale copy/symlink first so a repeat install
# lands cleanly.
# lsregister (outside PATH) forces LaunchServices to pick up the copied .app;
# mdimport updates only the Spotlight store, not the LS database.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# The console user (driving Installer.app). The LS database is per-user and
# this runs as root — registering as root doesn't reliably surface the app
# for the logged-in user (intermittently missing from search).
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")

# Register an .app with Launch Services + Spotlight, as the console
# user when there is one (headless installs fall back to root).
register_app() {
    local app="$1"
    # Best-effort: registration failure must NOT abort the install (the bundle
    # is already in /Applications and macOS indexes it on the next rescan), but
    # log the real outcome rather than a blanket "ran".
    if [[ -x "$LSREGISTER" ]]; then
        local ok=1
        # Per-user LS DB → prefer the console user, fall back to
        # root. -trusted isn't accepted on every macOS release, so try it then
        # plain before giving up.
        if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
            sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R -trusted "$app" 2>/dev/null \
                || sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R "$app" 2>/dev/null \
                || "$LSREGISTER" -f -R "$app" 2>/dev/null || ok=0
        else
            "$LSREGISTER" -f -R -trusted "$app" 2>/dev/null \
                || "$LSREGISTER" -f -R "$app" 2>/dev/null || ok=0
        fi
        if [[ "$ok" -eq 1 ]]; then
            log "lsregister registered $app (user: ${CONSOLE_USER:-root})"
        else
            log "WARN: lsregister failed for $app — Spotlight may lag until the next rescan"
        fi
    fi
    if command -v mdimport >/dev/null 2>&1; then
        if mdimport "$app" 2>/dev/null; then
            log "mdimport ran on $app"
        else
            log "WARN: mdimport failed for $app"
        fi
    fi
}

if [[ -d "$COMPANION_APP" ]]; then
    rm -rf "$COMPANION_SYMLINK"
    ditto "$COMPANION_APP" "$COMPANION_SYMLINK"
    # The OTA runs as the user (LaunchAgent) and must own the bundles to replace
    # them on update, same as versions/. Without this the whole-app OTA can't swap
    # the companion and the UI stays on the old build.
    if [[ "$INSTALL_USER" != "root" ]]; then
        chown -R "$INSTALL_USER:staff" "$COMPANION_APP" "$COMPANION_SYMLINK"
    fi
    log "companion copied: $COMPANION_APP -> $COMPANION_SYMLINK"
    register_app "$COMPANION_SYMLINK"
else
    log "companion app not found at $COMPANION_APP — skipping /Applications copy"
fi

# --- 4b. Remove legacy Setup Assistant.app ---------------------------
# LEGACY-SA-CLEANUP: pre-merge installs shipped a separate onboarding app;
# onboarding is now a window of the main app. Clear both copies + their
# LaunchServices entries so a stale tile / Spotlight hit doesn't linger after an
# upgrade. Remove this block once no pre-merge install remains.
for legacy in "$LEGACY_SA" "$LEGACY_SA_IN_APPLICATIONS"; do
    if [[ -d "$legacy" ]]; then
        [[ -x "$LSREGISTER" ]] && "$LSREGISTER" -u "$legacy" 2>/dev/null || true
        rm -rf "$legacy"
        log "removed legacy Setup Assistant: $legacy"
    fi
done

# --- 5. Launch Locai Link via launchd --------------------------------
# postinstall runs as root; the app must run as the console user (its LaunchAgent
# GUI domain + Keychain). We bootstrap the LaunchAgent rather than `open -a` so
# LAUNCHD OWNS THE ONE INSTANCE from install — parity with the Linux systemd
# service, and required now that the tauri single-instance guard is gone (an
# `open`-launched tray would run alongside the launchd one). First run has no
# registered device, so the app opens the setup window. `install_launchagents`
# at Finish only tweaks RunAtLoad — it does not re-bootstrap (that would restart
# the wizard mid-onboarding).
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
    # No graphical console user (headless / remote / root Terminal). Skip the
    # launch — the user can open Locai Link manually (it self-bootstraps at login).
    log "no console user detected; skipping launchd bootstrap"
    exit 0
fi

USER_UID=$(id -u "$CONSOLE_USER")
USER_LA="/Users/$CONSOLE_USER/Library/LaunchAgents"
PLIST_SRC="${INSTALL_ROOT}/LaunchAgents/uk.co.locai.link.companion.plist"
PLIST_DST="${USER_LA}/uk.co.locai.link.companion.plist"
SERVICE="gui/${USER_UID}/uk.co.locai.link.companion"

if [[ -f "$PLIST_SRC" ]]; then
    sudo -u "$CONSOLE_USER" mkdir -p "$USER_LA"
    install -m 0644 "$PLIST_SRC" "$PLIST_DST"
    chown "${CONSOLE_USER}:staff" "$PLIST_DST"
    # bootout any stale job, then bootstrap + kickstart in the user's GUI domain.
    sudo -u "$CONSOLE_USER" launchctl bootout "$SERVICE" 2>/dev/null || true
    if sudo -u "$CONSOLE_USER" launchctl bootstrap "gui/${USER_UID}" "$PLIST_DST"; then
        sudo -u "$CONSOLE_USER" launchctl kickstart -k "$SERVICE" \
            || log "WARN: kickstart $SERVICE failed"
        log "Locai Link bootstrapped into launchd for $CONSOLE_USER ($SERVICE)"
    else
        log "WARN: launchctl bootstrap failed; user must launch Locai Link manually"
    fi
else
    log "companion plist not at $PLIST_SRC; user must launch Locai Link manually"
fi

exit 0
