#
# systemd user service for the Locai Link runtime.
#
# Installed to ~/.config/systemd/user/ by the Setup Assistant on
# Finish. Enable with:
#
#     systemctl --user daemon-reload
#     systemctl --user enable --now locai-link-agent.service
#
# The "Start at login" checkbox on the Permissions step controls only
# the `enable` vs `start` verb — an enabled unit auto-starts at every
# graphical session; a merely-started one runs now but stays down at
# next login.
#
# ExecStart points at the Rust launcher (locai-link). The launcher
# resolves the `current` symlink to find the active version and exec's
# the PyInstaller-bundled runtime; OTA updates flip that symlink
# without touching this unit.

[Unit]
Description=Locai Link Agent (runtime)
Documentation=https://control.locai.co.uk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory so the runtime's StateManager (STATE_DIR =
# Path("configs")) resolves to ~/.local/share/locai/configs, matching
# where the Setup Assistant wrote the session file.
WorkingDirectory=%h/.local/share/locai
ExecStart=%h/.local/share/locai/locai-link run
Restart=on-failure
RestartSec=5s
# Split stdout/stderr into predictable files so the companion's
# Preferences → Advanced → Open folder points at something useful.
# Append rather than truncate — journald still captures too via
# StandardOutput=journal+file semantics.
StandardOutput=append:%h/.local/share/locai/logs/agent.stdout.log
StandardError=append:%h/.local/share/locai/logs/agent.stderr.log

[Install]
WantedBy=default.target
