[Desktop Entry]
Type=Application
Name=Locai Setup Assistant
GenericName=Locai Link first-run wizard
Comment=Re-run the Locai Link setup wizard
# Baked-in env vars match what install.sh sets when launching the SA:
# DMABUF renderer off (Wayland GBM failures) + force X11 backend
# (universally-working tray/window path). Users who want to try native
# Wayland can create a copy of this .desktop with the env stripped.
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_BACKEND=x11 %h/.local/share/locai/setup-assistant
Icon=locai-link
Terminal=false
Categories=Utility;Settings;
StartupNotify=true
Keywords=locai;setup;wizard;
