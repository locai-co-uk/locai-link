[Desktop Entry]
Type=Application
Name=Locai Setup Assistant
GenericName=Locai Link first-run wizard
Comment=Re-run the Locai Link setup wizard
# Baked-in env vars match what install.sh sets when launching the SA:
# DMABUF renderer off (Wayland GBM failures) + force X11 backend
# (universally-working tray/window path). Users who want to try native
# Wayland can create a copy of this .desktop with the env stripped.
#
# `@HOME@` is substituted with the real user home by install.sh at
# copy time. Desktop Entry spec doesn't define a home-dir field code
# (%h is a KDE-only extension; GNOME/xdg-open treat it as a literal
# `%h` and try to run a nonexistent path). Absolute path is the only
# portable answer.
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_BACKEND=x11 @HOME@/.local/share/locai/setup-assistant
Icon=locai-link
Terminal=false
Categories=Utility;Settings;
StartupNotify=true
Keywords=locai;setup;wizard;
